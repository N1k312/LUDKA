# Веб-сервер платформы: Mini App как статика + API и вебхуки ботов в бэкенд.
# HTTPS снаружи даёт туннель cloudflared, поэтому здесь обычный HTTP на :80.
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /tg/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	redir /app /app/
	handle_path /app/* {
		root * /srv/app
		# Хэшированные файлы сборки кэшируются надолго, index.html — нет.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		respond "Not found" 404
	}
}
