# Скопируйте в .env и заполните. Файл .env не попадает в git.

# PostgreSQL (контейнер db в docker-compose.yml)
POSTGRES_USER=bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bot

# Подключение к базе для локального запуска (pytest, uvicorn на компьютере).
# Внутри Docker Compose хост базы подменяется на db автоматически.
DATABASE_URL=postgresql+asyncpg://bot:change-me@localhost:5432/bot

# Ключ шифрования токенов ботов (Fernet, 32 байта в base64).
# Сгенерировать: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# Публичный HTTPS-адрес сервера: адрес туннеля cloudflared при разработке, домен на сервере.
PUBLIC_BASE_URL=http://localhost:8000

# dev или prod
ENV=dev

# Токен тестового бота из @BotFather (только для разработки, в git не попадает).
# В рабочей схеме токены клубов хранятся в базе зашифрованными.
TEST_BOT_TOKEN=

# Запуск на своём компьютере (deploy/compose.server.yml):
# папка для ежедневных бэкапов базы — лучше в OneDrive / Google Drive / на другом диске.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Владельцы платформы: Telegram id через запятую. Во всех ботах клубов у них
# максимальные права: назначают суперадмина клуба и любых сотрудников (/admin).
PLATFORM_OWNER_IDS=
